# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:3000

# ── Database (PostgreSQL) ─────────────────────────────────
# DATABASE_URL: connection the app uses at runtime. On Neon use the POOLED
#   endpoint (host contains "-pooler") with &pgbouncer=true.
# DIRECT_URL:   non-pooled connection used ONLY by Prisma Migrate. On Neon this
#   is the same host WITHOUT "-pooler". For a plain local Postgres, set both to
#   the same URL (or omit DIRECT_URL).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ── Auth (used from Session 3 onward) ─────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ── Cloud image storage: Cloudinary (Session 4 onward) ────
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=real-estate

# ── WhatsApp PDF scheduler (optional) ─────────────────────
# Off unless WHATSAPP_ENABLED=true. First boot prints a QR in the server logs;
# scan it once (WhatsApp → Linked devices). The session is saved under
# WA_AUTH_DIR — on an ephemeral host (Render's default disk) mount a persistent
# disk there or you'll re-scan on every deploy.
WHATSAPP_ENABLED=false
WA_AUTH_DIR=./auth_info_baileys
PDF_FILE_PATH=./documents/report.pdf
# Recipient phone, international format, digits only, no "+" (e.g. 919876543210)
PDF_RECIPIENT_PHONE=
# Comma-separated 24h HH:mm times, interpreted in PDF_TIMEZONE below
PDF_SCHEDULE_TIMES=09:00,12:00,15:00,18:00,21:00
# IANA timezone the times above mean (so 09:00 = 9 AM there, any host)
PDF_TIMEZONE=Asia/Kolkata
