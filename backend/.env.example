# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:3000

# ── Database (PostgreSQL) ─────────────────────────────────
# DATABASE_URL: connection the app uses at runtime. On Neon use the POOLED
#   endpoint (host contains "-pooler") with &pgbouncer=true.
# DIRECT_URL:   non-pooled connection used ONLY by Prisma Migrate. On Neon this
#   is the same host WITHOUT "-pooler". For a plain local Postgres, set both to
#   the same URL (or omit DIRECT_URL).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ── Auth (used from Session 3 onward) ─────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ── Cloud image storage: Cloudinary (Session 4 onward) ────
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=real-estate
